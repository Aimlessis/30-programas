<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaEjercicios.ViewModels"
             x:Class="AvaloniaEjercicios.Views.ExerciseView"
             x:DataType="vm:ExerciseViewModel">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#475569" />

            <ItemsControl ItemsSource="{Binding Inputs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InputFieldViewModel">
                        <StackPanel Margin="0,4" Spacing="4">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Value, Mode=TwoWay}"
                                     Watermark="{Binding Placeholder}" Width="400"
                                     HorizontalAlignment="Left" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Calcular" Command="{Binding CalculateCommand}"
                    Padding="20,8" HorizontalAlignment="Left" />

            <Border Background="{Binding HasError, Converter={x:Static vm:ErrorToBrushConverter.Instance}}"
                    CornerRadius="6" Padding="14" Margin="0,10,0,0">
                <TextBlock Text="{Binding Result}" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" />
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
